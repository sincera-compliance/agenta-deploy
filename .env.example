# Agenta 2.0 OSS - variáveis essenciais
# Copie para o campo Environment Variables do recurso Docker Compose no Coolify.
# Gere os segredos com: openssl rand -hex 32

AGENTA_LICENSE=oss

# URL pública do Agenta (a mesma que você vai abrir no navegador)
AGENTA_WEB_URL=https://agenta.sinceracompliance.com.br
AGENTA_API_URL=https://agenta.sinceracompliance.com.br/api
AGENTA_SERVICES_URL=https://agenta.sinceracompliance.com.br/services

# Segredos internos (troque todos)
AGENTA_AUTH_KEY=replace-me
AGENTA_SERVICES_INTERNAL_KEY=replace-me
AGENTA_CRYPT_KEY=replace-me
AGENTA_RUNNER_TOKEN=replace-me

# Object store interno (SeaweedFS)
AGENTA_STORE_ACCESS_KEY=replace-me
AGENTA_STORE_SECRET_KEY=replace-me
AGENTA_STORE_SIGNING_KEY=replace-me
AGENTA_STORE_BUCKET=agenta-store
AGENTA_STORE_ENDPOINT_URL=http://seaweedfs:8333

# Postgres
POSTGRES_USER=username
POSTGRES_PASSWORD=replace-me
POSTGRES_URI_CORE=postgresql+asyncpg://username:replace-me@postgres:5432/agenta_oss_core
POSTGRES_URI_SUPERTOKENS=postgresql://username:replace-me@postgres:5432/agenta_oss_supertokens
POSTGRES_URI_TRACING=postgresql+asyncpg://username:replace-me@postgres:5432/agenta_oss_tracing

# Acesso e cadastro
AGENTA_ACCESS_ALLOWED_DOMAINS=sinceracompliance.com.br
AGENTA_ACCESS_TRUSTED_PROXY_HOPS=1

# Runner e sandbox
AGENTA_RUNNER_ENABLED_SANDBOX_PROVIDERS=local
AGENTA_RUNNER_DEFAULT_SANDBOX_PROVIDER=local

# Gateways
AGENTA_MCP_GATEWAY_ENABLED=true
AGENTA_GATEWAYS_INSECURE_EGRESS_ALLOWED=false
AGENTA_GATEWAYS_INSECURE_HTTP_ALLOWED=false
AGENTA_INSECURE_EGRESS_ALLOWED=false

# Modelo
ANTHROPIC_API_KEY=replace-me

# URL publica (navegador). Ex: https://agenta.sinceracompliance.com.br
AGENTA_PUBLIC_URL=http://localhost:8080
